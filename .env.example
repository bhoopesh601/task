# Database Configuration (SQLite default; for PostgreSQL use: postgresql://user:password@localhost:5432/taskflow)
DATABASE_URL="file:./dev.db"

# JWT Secret Key for token signing
JWT_SECRET="your_jwt_secret_key_here"

# Server Port
PORT=5000

# ==============================================================================
# SMTP Email Configuration (Default: Hostinger Webmail)
# ==============================================================================
# Hostinger Webmail SMTP:
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="user@yourdomain.com"
SMTP_PASS="your_hostinger_webmail_password"
SMTP_FROM="user@yourdomain.com"

# To upgrade / switch to Gmail in the future, set:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-character-google-app-password"
# ==============================================================================
